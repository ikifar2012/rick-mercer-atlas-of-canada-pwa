---
import BrandMark from '../components/BrandMark.astro';
import UpdatePrompt from '../components/UpdatePrompt';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  fullscreen?: boolean;
}

const {
  title = 'The Unofficial Rick Mercer Atlas of Canada',
  description = 'Explore hundreds of Rick Mercer adventures across Canada by place, season, and year.',
  image = '/og-default.svg',
  fullscreen = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d62828" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class={`site-shell ${fullscreen ? 'site-shell--fullscreen' : ''}`}>
      <header class="masthead">
        <BrandMark />
        <nav class="masthead__actions" aria-label="Main navigation">
          <a href="/places">All places</a>
          <a href="/about">About</a>
          <span class="archive-badge">Unofficial fan archive</span>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="footer">
        <p>An independent, unofficial fan archive. Not affiliated with Rick Mercer or CBC.</p>
        <p><a href="/about">About this project</a> · <a href={import.meta.env.PUBLIC_ISSUES_URL || '#'}>Corrections & rights</a></p>
      </footer>
      <UpdatePrompt client:load />
    </div>
  </body>
</html>
