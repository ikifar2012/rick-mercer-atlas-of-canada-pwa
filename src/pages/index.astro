---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasExplorer from '../components/AtlasExplorer';
import data from '../../data/pois.json';
const count = data.pois.length;
---
<BaseLayout fullscreen>
  <section class="hero-map">
    <div class="hero-map__intro">
      <p><strong>{count} stories</strong> · 15 seasons · coast to coast to coast</p>
    </div>
    <AtlasExplorer client:load />
  </section>
</BaseLayout>
