{
  "name": "rick-mercer-atlas-of-canada-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
